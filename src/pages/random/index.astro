---
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import SiteShell from '../../layouts/SiteShell.astro';

const links = [
	{
		title: 'Colour of neuromodulators',
		href: '/random/neuromodulator-colors',
		description:
			'Pick a colour for serotonin, noradrenaline, dopamine and acetylcholine, then see what everyone else picked.',
	},
];
---

<SiteShell title={`Random — ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<h1 class="mb-10 font-display text-5xl">Random</h1>
	<ul class="divide-y">
		{
			links.map((link) => (
				<li>
					<a href={link.href} class="group block py-6">
						<div class="flex items-baseline justify-between gap-4">
							<h2 class="font-display text-2xl transition-colors group-hover:text-accent">{link.title}</h2>
							<span aria-hidden="true" class="shrink-0 text-muted-foreground transition-colors group-hover:text-accent">→</span>
						</div>
						<p class="mt-2 text-muted-foreground">{link.description}</p>
					</a>
				</li>
			))
		}
	</ul>
</SiteShell>
