---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
}

const { title, description, type } = Astro.props;

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/recipes', label: 'Cabbage recipes' },
	{ href: '/random', label: 'Random' },
	{ href: '/about', label: 'About' },
];

const social = [
	{
		href: 'https://bsky.app/profile/romodorro.bsky.social',
		label: 'Bluesky',
		viewBox: '0 0 24 24',
		d: 'M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026',
	},
	{
		href: 'https://github.com/bastak',
		label: 'GitHub',
		viewBox: '0 0 16 16',
		d: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z',
	},
];

// Home is active only on "/", every other section on itself and its sub-pages.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
	href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} type={type} />
		<slot name="head" />
	</head>
	<body class="font-sans antialiased">
		<div class="mx-auto min-h-screen max-w-2xl px-6 py-12 md:py-20">
			<header class="mb-20 flex flex-wrap items-baseline justify-between gap-4">
				<a href="/" class="font-display text-2xl font-semibold tracking-tight">{SITE_TITLE}</a>
				<nav
					aria-label="Main navigation"
					class="flex flex-wrap items-baseline gap-x-4 gap-y-3 font-mono text-xs uppercase tracking-widest text-muted-foreground"
				>
					{
						nav.map((n) => (
							<a
								href={n.href}
								class:list={['hover:text-foreground', { 'text-accent': isActive(n.href) }]}
								aria-current={isActive(n.href) ? 'page' : undefined}
							>
								{n.label}
							</a>
						))
					}
				</nav>
			</header>
			<main class="pb-24">
				<slot />
			</main>
			<footer class="flex gap-4 border-t pt-6 text-muted-foreground">
				{
					social.map((s) => (
						<a href={s.href} target="_blank" rel="noopener" class="transition-colors hover:text-accent">
							<span class="sr-only">{s.label}</span>
							<svg viewBox={s.viewBox} aria-hidden="true" width="18" height="18">
								<path fill="currentColor" d={s.d} />
							</svg>
						</a>
					))
				}
			</footer>
		</div>
	</body>
</html>
